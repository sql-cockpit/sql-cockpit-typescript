{
  "name": "@sql-cockpit/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the SQL Cockpit portal API.",
  "license": "MIT",
  "author": "SQL Cockpit",
  "homepage": "https://github.com/sql-cockpit/sql-cockpit-typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sql-cockpit/sql-cockpit-typescript.git"
  },
  "private": true,
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/write-cjs-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.examples.json",
    "test": "npm run build && node --test test/client.test.mjs test/cjs.test.cjs",
    "prepare": "npm run build"
  },
  "keywords": [
    "sql-cockpit",
    "sdk",
    "api"
  ],
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
